{
  "model_name": "google/owlvit-base-patch32",
  "input_root": "data/MoCA/JPEGImages",
  "inference": {
    "threshold": 0.1,
    "top_k_per_frame": 5
  },
  "temporal_refine": {
    "top_k": 5,
    "iou_weight": 0.35,
    "area_penalty_lambda": 0.4,
    "min_score": 0.0,
